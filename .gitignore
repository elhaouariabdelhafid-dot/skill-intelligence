# ============================================================
#  skill-intelligence / EvaSmart — .gitignore
# ============================================================

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Secrets & configuration locale ---
.env
.env.local
*.pem
*.key

# --- Node / frontend ---
node_modules/
frontend-web/node_modules/
frontend-web/dist/
frontend-web/.vite/
*.local

# --- Données & volumes runtime (lourds, non versionnés) ---
data/
volumes/
!data/.gitkeep
*.pkl
*.jsonl
chroma/
qdrant/

# --- Sorties d'exécution ---
logs/
*.log
evaluation/results/
evaluation/human_ratings/

# --- Archives & sauvegardes ---
archive/
*.bak
*.bak[0-9]*
*.orig
*~
*.zip

# --- Notebooks ---
.ipynb_checkpoints/

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/settings.json
