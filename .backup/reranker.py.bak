"""Phase 2 — Re-ranking par cross-encoder BGE-reranker-v2-m3.

POURQUOI : le bi-encoder (BGE-M3) encode question et document SÉPARÉMENT —
rapide mais approximatif. Le cross-encoder lit la paire (question, document)
ENSEMBLE — précis mais lent. Stratégie classique en deux étages :
    hybride ramène 10-25 candidats  ->  cross-encoder réordonne  ->  top 5.
Coût : ~1-2 s sur CPU pour 10 paires. Acceptable (< NF1 de 2 s si batché).

Usage :
    python retrieval/reranker.py "How does IAM evaluate policies?"
"""
from __future__ import annotations
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))
from config import settings
from retrieval.hybrid import retrieve_hybrid
from retrieval.query_naive import RetrievedChunk, build_prompt, generate

from sentence_transformers import CrossEncoder

_reranker: CrossEncoder | None = None


def reranker() -> CrossEncoder:
    global _reranker
    if _reranker is None:
        # Premier appel : télécharge ~2,2 Go
        _reranker = CrossEncoder(settings.reranker_model, max_length=1024)
    return _reranker


def rerank(query: str, chunks: list[RetrievedChunk],
           top_k: int = 5) -> list[RetrievedChunk]:
    if not chunks:
        return []
    pairs = [(query, c.text) for c in chunks]
    scores = reranker().predict(pairs)
    order = sorted(range(len(chunks)), key=lambda i: scores[i], reverse=True)
    out = []
    for i in order[:top_k]:
        c = chunks[i]
        out.append(RetrievedChunk(chunk_id=c.chunk_id, text=c.text,
                                  source_file=c.source_file, service=c.service,
                                  section=c.section, score=float(scores[i])))
    return out


def retrieve_final(query: str, top_k: int = 5) -> list[RetrievedChunk]:
    """Pipeline de retrieval complet Phase 2 : hybride -> rerank.
    C'est CETTE fonction que la génération (Phase 3) et les agents (Phase 4)
    utiliseront."""
    candidates = retrieve_hybrid(query, top_k=15, fetch_k=30)
    return rerank(query, candidates, top_k=top_k)


def answer_v2(query: str) -> dict:
    chunks = retrieve_final(query)
    text = generate(build_prompt(query, chunks))
    return {
        "answer": text,
        "sources": [{"tag": f"S{i+1}", "file": c.source_file,
                     "section": c.section, "rerank_score": round(c.score, 3)}
                    for i, c in enumerate(chunks)],
    }


if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("query", nargs="+")
    args = parser.parse_args()
    result = answer_v2(" ".join(args.query))
    print("\n=== RÉPONSE (RAG v2 : hybride + rerank) ===\n")
    print(result["answer"])
    print("\n=== SOURCES ===")
    for s in result["sources"]:
        print(f"  [{s['tag']}] {s['file']}  ({s['section']})  {s['rerank_score']}")
