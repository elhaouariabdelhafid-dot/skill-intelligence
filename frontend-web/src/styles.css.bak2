:root{
  --bg:#F6F8FC; --panel:#FFFFFF; --glass:rgba(255,255,255,.72); --glass-brd:rgba(255,255,255,.85);
  --ink:#0F1729; --ink-2:#475069; --muted:#8892A6; --line:#E6EAF2; --line-2:#D6DDEA;
  --grad-a:#4F46E5; --grad-b:#2C6BE8; --grad-c:#7C3AED;
  --ok:#0EA47C; --err:#E0455E; --amber:#E8930C;
  --shadow-sm:0 1px 2px rgba(16,24,40,.05);
  --shadow:0 8px 24px -6px rgba(16,24,40,.09),0 2px 6px rgba(16,24,40,.05);
  --shadow-lg:0 28px 60px -18px rgba(31,41,90,.22),0 8px 20px -8px rgba(16,24,40,.1);
}
body.dark{
  --bg:#080C16; --panel:#0F1522; --glass:rgba(20,27,42,.74); --glass-brd:rgba(255,255,255,.09);
  --ink:#EEF2FA; --ink-2:#A9B4CA; --muted:#77839B; --line:#1E2739; --line-2:#2A354B;
  --shadow-sm:0 1px 2px rgba(0,0,0,.3);
  --shadow:0 8px 24px -6px rgba(0,0,0,.5),0 2px 6px rgba(0,0,0,.35);
  --shadow-lg:0 30px 70px -20px rgba(0,0,0,.7),0 8px 22px -8px rgba(0,0,0,.5);
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);transition:background .45s ease}
.app{font-family:'Inter',system-ui,-apple-system,sans-serif;color:var(--ink);
  -webkit-font-smoothing:antialiased;min-height:100vh;background:var(--bg);
  transition:background .45s ease,color .45s ease}
h1,h2,.logo-word,.stat-value,.boot-word,.hero-title,.gauge-val{font-family:'Poppins',sans-serif}
.mono{font-family:'JetBrains Mono',monospace;font-variant-numeric:tabular-nums;font-size:12px}
button{font-family:inherit}
:focus-visible{outline:2.5px solid var(--grad-a);outline-offset:2px;border-radius:8px}
.dim{color:var(--muted)}.strong{font-weight:600}

@keyframes rise{from{opacity:0;transform:translateY(16px) scale(.985)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes float{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-22px) rotate(4deg)}}
@keyframes drift{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(26px,-30px) scale(1.07)}66%{transform:translate(-20px,18px) scale(.95)}}
@keyframes wave{0%,60%,100%{transform:rotate(0)}10%,30%{transform:rotate(16deg)}20%{transform:rotate(-10deg)}40%{transform:rotate(9deg)}}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
@keyframes shake{10%,90%{transform:translateX(-2px)}20%,80%{transform:translateX(4px)}30%,50%,70%{transform:translateX(-7px)}40%,60%{transform:translateX(7px)}}
@keyframes pop{0%{opacity:0;transform:scale(.9)}60%{transform:scale(1.03)}100%{opacity:1;transform:scale(1)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes rippleOut{to{transform:scale(15);opacity:0}}
@keyframes particleUp{0%{transform:translateY(0)}100%{transform:translateY(-120px)}}
@keyframes grow{from{width:0}}
.rise{animation:rise .6s cubic-bezier(.22,.9,.28,1) both}
.fade-in{animation:fadeIn .55s ease both}
.pop{animation:pop .38s cubic-bezier(.22,1.2,.36,1) both}
.shake{animation:shake .55s cubic-bezier(.36,.07,.19,.97) both}
.spin{animation:spin .85s linear infinite}

/* login */
.login{display:grid;grid-template-columns:1.02fr .98fr;min-height:100vh}
.hero{position:relative;overflow:hidden;display:flex;align-items:center;color:#fff;padding:50px 52px;
  background:linear-gradient(145deg,#3E3BD6 0%,#2F5FE0 48%,#6D34E0 100%)}
body.dark .hero{background:linear-gradient(145deg,#241F86 0%,#17346F 48%,#3E1A80 100%)}
.orb{position:absolute;border-radius:50%;filter:blur(72px);pointer-events:none;animation:drift 22s ease-in-out infinite}
.orb-1{width:400px;height:400px;background:rgba(126,214,255,.42);top:-110px;left:-90px}
.orb-2{width:340px;height:340px;background:rgba(178,120,255,.45);bottom:-90px;right:-70px;animation-delay:-7s}
.orb-3{width:260px;height:260px;background:rgba(88,255,214,.28);top:44%;left:52%;animation-delay:-13s}
.particles{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.particles span{position:absolute;background:#fff;border-radius:50%;animation:particleUp linear infinite}
.float-icon{position:absolute;font-size:29px;animation:float ease-in-out infinite;
  filter:drop-shadow(0 6px 14px rgba(0,0,0,.22));pointer-events:none;user-select:none}
.hero-inner{position:relative;z-index:2;max-width:492px}
.hero-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.16);
  border:1px solid rgba(255,255,255,.26);backdrop-filter:blur(12px);padding:6px 13px;border-radius:22px;
  font-size:11.5px;font-weight:500}
.hero-greet{margin-top:24px;font-size:15px;font-weight:500;opacity:.94;display:flex;align-items:center;gap:9px}
.wave{display:inline-block;font-size:21px;transform-origin:70% 70%;animation:wave 2.6s ease-in-out infinite}
.hero-title{font-size:41px;line-height:1.12;font-weight:700;letter-spacing:-1.2px;margin-top:8px;min-height:50px}
.caret{display:inline-block;width:3px;height:.8em;background:#fff;margin-left:4px;vertical-align:-2px;
  border-radius:2px;animation:blink 1s step-end infinite}
.caret-done{animation:blink 1.4s step-end infinite;opacity:.55}
.hero-sub{margin-top:15px;font-size:14px;line-height:1.68;color:rgba(255,255,255,.84);max-width:47ch}
.hero-points{list-style:none;margin-top:24px;display:flex;flex-direction:column;gap:11px}
.hero-points li{display:flex;align-items:center;gap:12px;font-size:13px;color:rgba(255,255,255,.92)}
.hp-ico{width:30px;height:30px;border-radius:9px;background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.2);display:grid;place-items:center;flex-shrink:0}

.pane{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:38px 30px;background:var(--bg);overflow-y:auto}
.theme-toggle{position:absolute;top:22px;right:26px;background:none;border:none;cursor:pointer;padding:4px}
.tt-track{display:block;width:46px;height:25px;border-radius:20px;background:var(--line);
  border:1px solid var(--line-2);position:relative;transition:background .3s}
.tt-thumb{position:absolute;top:2px;left:2px;width:19px;height:19px;border-radius:50%;background:var(--panel);
  box-shadow:var(--shadow-sm);display:grid;place-items:center;color:var(--amber);
  transition:transform .34s cubic-bezier(.3,1.4,.5,1),color .3s}
.tt-on{transform:translateX(21px);color:#9BA9FF}
.card{width:100%;max-width:432px;background:var(--glass);backdrop-filter:blur(22px);
  -webkit-backdrop-filter:blur(22px);border:1px solid var(--glass-brd);border-radius:24px;
  padding:30px 30px 26px;box-shadow:var(--shadow-lg)}
.card-head{text-align:center;margin-bottom:22px}
.logo{display:inline-flex;align-items:center;gap:10px}
.logo-mark{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;color:#fff;
  background:linear-gradient(135deg,var(--grad-a),var(--grad-b) 55%,var(--grad-c));
  box-shadow:0 6px 16px -4px rgba(79,70,229,.5)}
.logo-word{font-size:19px;font-weight:700;letter-spacing:-.6px}
.card-head h2{font-size:20px;font-weight:600;letter-spacing:-.5px;margin-top:16px}
.card-head p{font-size:13.5px;color:var(--muted);margin-top:3px}
.fields{display:flex;flex-direction:column;gap:14px}
.field-label{display:block;font-size:12px;font-weight:500;color:var(--ink-2);margin-bottom:6px}
.input-wrap{position:relative;display:block}
.input-ico{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none}
.input-wrap input{width:100%;padding:12px 14px 12px 39px;border:1px solid var(--line-2);border-radius:13px;
  font-size:14px;background:var(--panel);color:var(--ink);transition:border-color .18s,box-shadow .18s}
.input-wrap input:not(:has(+ .input-ico)){padding-left:14px}
.input-wrap input::placeholder{color:var(--muted);opacity:.75}
.input-wrap input:focus{outline:none;border-color:var(--grad-a);box-shadow:0 0 0 4px rgba(79,70,229,.13)}
.input-btn{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;
  color:var(--muted);cursor:pointer;padding:6px;border-radius:8px}
.input-btn:hover{color:var(--ink);background:var(--line)}
.row-between{display:flex;align-items:center;justify-content:space-between;gap:12px}
.check{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
.check input{position:absolute;opacity:0;width:0;height:0}
.check-box{width:17px;height:17px;border-radius:5.5px;border:1.6px solid var(--line-2);background:var(--panel);
  display:grid;place-items:center;color:transparent;transition:all .18s}
.check input:checked + .check-box{background:linear-gradient(135deg,var(--grad-a),var(--grad-b));
  border-color:transparent;color:#fff}
.check-text{font-size:12.5px;color:var(--ink-2)}
.link{display:flex;align-items:center;gap:5px;background:none;border:none;color:var(--grad-a);
  font-size:12.5px;font-weight:500;cursor:pointer;padding:2px}
.link:hover{opacity:.72}
.alert{display:flex;align-items:center;gap:8px;padding:10px 13px;border-radius:12px;font-size:13px;font-weight:500}
.alert-error{background:rgba(224,69,94,.1);color:var(--err);border:1px solid rgba(224,69,94,.24)}
.alert-success{background:rgba(14,164,124,.1);color:var(--ok);border:1px solid rgba(14,164,124,.24)}
.btn-signin{position:relative;overflow:hidden;width:100%;padding:13px;border:none;border-radius:13px;
  background:linear-gradient(120deg,var(--grad-a),var(--grad-b) 50%,var(--grad-c));background-size:200% auto;
  color:#fff;font-size:14.5px;font-weight:600;cursor:pointer;display:flex;align-items:center;
  justify-content:center;gap:8px;box-shadow:0 8px 20px -6px rgba(79,70,229,.5);
  transition:transform .18s cubic-bezier(.3,1.3,.5,1),box-shadow .22s,background-position .5s}
.btn-signin:hover:not(:disabled){transform:scale(1.018) translateY(-1px);
  box-shadow:0 14px 30px -8px rgba(79,70,229,.62);background-position:100% 50%}
.btn-signin:disabled{cursor:default;opacity:.92}
.btn-inline{width:auto;padding:11px 18px;font-size:13.5px}
.btn-arrow{transition:transform .22s}
.btn-signin:hover .btn-arrow{transform:translateX(3px)}
.ripple{position:absolute;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;
  background:rgba(255,255,255,.5);pointer-events:none;animation:rippleOut .62s ease-out forwards}
.demo{margin-top:4px;border-top:1px solid var(--line);padding-top:16px}
.demo-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10px}
.demo-head span:first-child{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.1px;color:var(--ink-2)}
.demo-hint{font-size:11px;color:var(--muted)}
.demo-grid{display:flex;flex-direction:column;gap:7px}
.demo-card{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:14px;
  border:1px solid var(--line);background:var(--panel);transition:transform .18s,box-shadow .18s}
.demo-card:hover{transform:translateX(3px);box-shadow:var(--shadow)}
.demo-av{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;color:#fff;flex-shrink:0}
.tint-violet .demo-av,.tint-violet.demo-av{background:linear-gradient(135deg,#7C3AED,#A855F7)}
.tint-blue .demo-av,.tint-blue.demo-av{background:linear-gradient(135deg,#2C6BE8,#38BDF8)}
.tint-teal .demo-av,.tint-teal.demo-av{background:linear-gradient(135deg,#0EA47C,#34D399)}
.tint-amber .demo-av,.tint-amber.demo-av{background:linear-gradient(135deg,#E8930C,#FBBF24)}
.tint-indigo .demo-av,.tint-indigo.demo-av{background:linear-gradient(135deg,#4F46E5,#818CF8)}
.demo-meta{flex:1;min-width:0}
.demo-meta strong{display:block;font-size:12.5px;font-weight:600}
.demo-meta span{display:block;font-size:10.5px;color:var(--muted);font-family:'JetBrains Mono',monospace;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.demo-go{padding:6px 11px;border:1px solid var(--line-2);border-radius:9px;background:transparent;
  color:var(--grad-a);font-size:11.5px;font-weight:600;cursor:pointer;flex-shrink:0;transition:all .18s}
.demo-go:hover{background:linear-gradient(135deg,var(--grad-a),var(--grad-b));color:#fff;border-color:transparent}
.pane-foot{margin-top:18px;font-size:11.5px;color:var(--muted);text-align:center}

/* boot */
.boot{position:relative;min-height:100vh;display:grid;place-items:center;overflow:hidden;
  background:linear-gradient(150deg,#3E3BD6,#2F5FE0 50%,#6D34E0);color:#fff}
body.dark .boot{background:linear-gradient(150deg,#241F86,#17346F 50%,#3E1A80)}
.boot-inner{position:relative;z-index:2;text-align:center;animation:rise .6s cubic-bezier(.22,.9,.28,1) both}
.boot-ring{position:relative;display:inline-grid;place-items:center}
.ring-bg{fill:none;stroke:rgba(255,255,255,.18);stroke-width:6}
.ring-fg{fill:none;stroke:#fff;stroke-width:6;stroke-linecap:round;transition:stroke-dashoffset .3s linear}
.boot-logo{position:absolute;display:grid;place-items:center;color:#fff;animation:float 3.2s ease-in-out infinite}
.boot-word{font-size:26px;font-weight:700;letter-spacing:-.8px;margin-top:16px}
.boot-steps{margin-top:18px;display:flex;flex-direction:column;gap:7px;align-items:flex-start;min-width:290px}
.boot-step{display:flex;align-items:center;gap:9px;font-size:12.5px;color:rgba(255,255,255,.42);
  transition:color .35s,transform .35s}
.boot-step.on{color:#fff;transform:translateX(3px)}
.boot-step.done{color:rgba(255,255,255,.72)}
.dot-idle{width:13px;height:13px;border-radius:50%;border:1.6px solid rgba(255,255,255,.28);display:block}
.boot-bar{width:300px;height:5px;border-radius:4px;background:rgba(255,255,255,.2);margin:20px auto 0;overflow:hidden}
.boot-fill{height:100%;border-radius:4px;background:#fff;transition:width .1s linear}
.boot-pct{display:block;font-family:'JetBrains Mono',monospace;font-size:12px;color:rgba(255,255,255,.8);margin-top:8px}
.boot-user{font-size:11.5px;color:rgba(255,255,255,.6);margin-top:12px}

/* workspace */
.dash{display:grid;grid-template-columns:230px 1fr;min-height:100vh;background:var(--bg)}
.dash-side{background:var(--panel);border-right:1px solid var(--line);padding:22px 15px;
  display:flex;flex-direction:column;gap:18px}
.logo-sm .logo-mark{width:30px;height:30px;border-radius:9px}
.logo-sm .logo-word{font-size:16px}
.dash-side nav{display:flex;flex-direction:column;gap:3px;flex:1}
.dnav{display:flex;align-items:center;gap:10px;padding:9px 12px;border:none;background:none;color:var(--ink-2);
  font-size:13.5px;border-radius:10px;cursor:pointer;text-align:left;transition:background .18s,color .18s}
.dnav:hover{background:var(--line);color:var(--ink)}
.dnav.on{background:linear-gradient(120deg,var(--grad-a),var(--grad-b));color:#fff;font-weight:500;
  box-shadow:0 6px 16px -6px rgba(79,70,229,.5)}
.dnav.quiet{font-size:12.5px}
.side-tools{border-top:1px solid var(--line);padding-top:14px}
.theme-inline{display:flex;align-items:center;gap:9px;width:100%;padding:8px 12px;border:none;background:none;
  color:var(--muted);font-size:12.5px;border-radius:9px;cursor:pointer}
.theme-inline:hover{background:var(--line);color:var(--ink)}
.dash-who{display:flex;align-items:center;gap:10px;padding-top:14px;border-top:1px solid var(--line)}
.dash-who strong{display:block;font-size:12.5px}
.dash-who span{display:block;font-size:11px;color:var(--muted)}
.dash-main{min-width:0;display:flex;flex-direction:column}
.dash-top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 30px 18px;
  border-bottom:1px solid var(--line);background:var(--panel)}
.eyebrow{font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:1.3px;color:var(--grad-a)}
.dash-top h1{font-size:22px;font-weight:600;letter-spacing:-.6px;margin-top:3px}
.top-right{display:flex;align-items:center;gap:10px}
.chip-live{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--ink-2);
  border:1px solid var(--line);border-radius:20px;padding:6px 13px}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px rgba(14,164,124,.18)}
.org-tag{font-size:11.5px;font-weight:600;color:var(--muted);border:1px solid var(--line);border-radius:20px;padding:6px 13px}
.dash-body{padding:22px 30px 44px;display:flex;flex-direction:column;gap:16px;animation:fadeIn .4s ease both}

.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:15px 17px;
  display:flex;flex-direction:column;gap:3px;box-shadow:var(--shadow-sm)}
.stat-label{font-size:11.5px;color:var(--muted)}
.stat-value{font-size:23px;font-weight:700;letter-spacing:-.8px}
.stat-sub{font-size:11px;color:var(--muted)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:19px 21px;box-shadow:var(--shadow-sm)}
.panel-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:14px}
.panel-head h2{font-size:15px;font-weight:600;letter-spacing:-.3px}
.panel-right{display:flex;align-items:center;gap:10px}
.panel-note{font-size:11.5px;color:var(--muted)}
.panel-lead{font-size:12.5px;color:var(--muted);margin-bottom:14px;line-height:1.62}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.btn-mini{display:flex;align-items:center;gap:6px;padding:5px 11px;border:1px solid var(--line-2);
  border-radius:9px;background:transparent;color:var(--ink-2);font-size:11.5px;cursor:pointer}
.btn-mini:hover{border-color:var(--grad-a);color:var(--grad-a)}

.state{display:flex;align-items:center;gap:11px;padding:22px;border:1px dashed var(--line-2);
  border-radius:14px;color:var(--muted);font-size:13px;justify-content:center;background:var(--panel)}
.state-err{border-color:rgba(224,69,94,.35);color:var(--err);flex-wrap:wrap}
.state-err strong{display:block;font-size:13px}
.state-err span{font-size:12px;opacity:.85}

.gauge{position:relative;flex-shrink:0}
.gauge-bg{fill:none;stroke:var(--line);stroke-width:9}
.gauge-fg{transition:stroke-dashoffset .95s cubic-bezier(.2,.8,.2,1)}
.gauge-mid{position:absolute;inset:0;display:grid;place-items:center;line-height:1}
.gauge-val{font-size:26px;font-weight:700;letter-spacing:-1px}
.gauge-unit{font-size:11px;color:var(--muted);margin-left:1px}
.profile-row{display:flex;align-items:center;gap:22px}
.profile-meta p{font-size:12.5px;color:var(--ink-2);line-height:1.62;margin-top:9px}
.pill{display:inline-block;font-size:11px;font-weight:600;padding:4px 11px;border-radius:20px}
.pill-high{background:rgba(14,164,124,.12);color:#0B8B69}.pill-mid{background:rgba(79,70,229,.12);color:#4338CA}
.pill-low{background:rgba(232,147,12,.13);color:#B4700A}.pill-critical{background:rgba(224,69,94,.12);color:#C22F45}
.meter{margin-bottom:11px}
.meter-head{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:5px;color:var(--ink-2)}
.meter-rail{height:7px;background:var(--line);border-radius:4px;overflow:hidden}
.meter-fill{height:100%;border-radius:4px;animation:grow .9s cubic-bezier(.22,.9,.28,1) both}
.meters-2col{display:grid;grid-template-columns:1fr 1fr;gap:0 26px}

.topology{width:100%;height:auto}
.topo-node{fill:var(--panel)}
.topo-link{stroke:var(--line-2);stroke-width:1.3}
.topo-link.blocked{stroke:var(--err);stroke-width:2;stroke-dasharray:5 4}
.topo-score{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600}
.topo-label{font-size:10.5px;fill:var(--muted);font-family:'Inter',sans-serif}
.topo-caption{font-size:11.5px;color:var(--muted);text-align:center;margin-top:8px;line-height:1.5}
.detail-split{display:grid;grid-template-columns:1fr 1.3fr;gap:26px;align-items:center}

.path{list-style:none;display:flex;flex-direction:column;gap:9px}
.path li{display:flex;gap:13px;padding:13px 15px;border:1px solid var(--line);border-radius:14px;background:var(--bg)}
.path-rank{width:25px;height:25px;border-radius:8px;display:grid;place-items:center;font-size:11.5px;
  font-weight:700;flex-shrink:0;font-family:'JetBrains Mono',monospace;color:#fff;
  background:linear-gradient(135deg,var(--grad-a),var(--grad-b))}
.path-body{flex:1;min-width:0}
.path-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.path-head strong{font-size:13.5px}
.path-note{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);margin-top:4px;line-height:1.5}
.path-note.warn{color:var(--amber)}
.res-list{list-style:none;margin-top:8px;display:flex;flex-direction:column;gap:4px}
.res-list li{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--ink-2);
  padding:0;border:none;background:none}

.table{width:100%;border-collapse:collapse;font-size:13px}
.table th{text-align:left;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;
  color:var(--muted);padding:0 10px 9px;border-bottom:1px solid var(--line)}
.table td{padding:10px;border-bottom:1px solid var(--line);vertical-align:middle}
.table tr:last-child td{border-bottom:none}
.q-text{max-width:360px;line-height:1.5}
.row-veto{background:rgba(224,69,94,.05)}
.cell-user{display:flex;align-items:center;gap:9px}
.cell-user .demo-av{width:26px;height:26px;border-radius:8px}
.raw{font-family:'JetBrains Mono',monospace;font-size:11.5px;line-height:1.7;white-space:pre-wrap;
  background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:14px 16px;color:var(--ink-2);overflow-x:auto}

.tag{display:inline-block;font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:6px;
  background:var(--line);color:var(--ink-2)}
.tag-ok{background:rgba(14,164,124,.13);color:#0B8B69}
.tag-warn{background:rgba(232,147,12,.15);color:#B4700A}
.tag-danger{background:rgba(224,69,94,.13);color:#C22F45;margin-left:7px}
.tag-beginner{background:rgba(14,164,124,.13);color:#0B8B69}
.tag-intermediate{background:rgba(79,70,229,.12);color:#4338CA}
.tag-advanced{background:rgba(124,58,237,.13);color:#6D28D9}
.tag-admin{background:rgba(124,58,237,.13);color:#6D28D9}
.tag-rh{background:rgba(44,107,232,.12);color:#1D4ED8}
.tag-manager{background:rgba(14,164,124,.13);color:#0B8B69}
.tag-formateur{background:rgba(232,147,12,.15);color:#B4700A}
.tag-collaborateur{background:var(--line);color:var(--ink-2)}
.dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:7px}
.dot-on{background:var(--ok)}.dot-off{background:var(--line-2)}

.chip-row{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
.chip{display:flex;align-items:center;gap:6px;padding:6px 13px;border:1px solid var(--line-2);border-radius:20px;
  background:var(--panel);font-size:12.5px;color:var(--ink-2);cursor:pointer;transition:all .18s}
.chip:hover{border-color:var(--grad-a);color:var(--grad-a)}
.chip-on{background:linear-gradient(120deg,var(--grad-a),var(--grad-b));color:#fff;border-color:transparent;font-weight:500}
.chip-on .mono{color:rgba(255,255,255,.85)}
.chip-sm{font-size:11.5px;padding:5px 11px}

.hm-scroll{overflow-x:auto}
.heatmap{display:grid;gap:3px;min-width:520px}
.hm-col{font-size:10.5px;font-weight:600;color:var(--muted);text-align:center;padding-bottom:7px}
.hm-row{font-size:12.5px;font-weight:500;display:flex;align-items:center;padding-right:12px}
.hm-cell{aspect-ratio:2.4/1;border-radius:7px;display:grid;place-items:center;
  font-family:'JetBrains Mono',monospace;font-size:11.5px;font-weight:600;color:#0F1729;transition:transform .12s}
.hm-cell:hover{transform:scale(1.06)}
.hm-na{background:var(--line);color:var(--muted)}
.hm-legend{display:flex;flex-wrap:wrap;gap:16px;margin-top:14px;font-size:11.5px;color:var(--muted)}
.hm-legend span{display:flex;align-items:center;gap:6px}
.hm-legend i{width:9px;height:9px;border-radius:2px;display:inline-block}

.person-row{display:grid;grid-template-columns:1fr 1.1fr auto auto;align-items:center;gap:14px;
  padding:11px 0;border-bottom:1px solid var(--line)}
.person-row:last-child{border-bottom:none}
.person-id{display:flex;align-items:center;gap:10px}
.person-id strong{display:block;font-size:13px}
.person-id .dim{font-size:11px}
.avatar{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;font-weight:700;
  font-size:14px;flex-shrink:0;color:#fff;background:linear-gradient(135deg,var(--grad-a),var(--grad-b))}

.launch{display:flex;flex-wrap:wrap;align-items:flex-end;gap:13px}
.field-inline{min-width:180px}
.field-inline input,.field-inline select{width:100%;padding:11px 13px;border:1px solid var(--line-2);
  border-radius:12px;font-size:13.5px;background:var(--panel);color:var(--ink);font-family:inherit}
.field-inline input:focus,.field-inline select:focus{outline:none;border-color:var(--grad-a);
  box-shadow:0 0 0 4px rgba(79,70,229,.13)}
.launch-info{display:flex;flex-wrap:wrap;align-items:center;gap:9px;margin-top:14px;font-size:12.5px;color:var(--ink-2)}
.notice{display:flex;align-items:flex-start;gap:9px;margin-top:14px;background:rgba(79,70,229,.07);
  border:1px solid rgba(79,70,229,.2);border-radius:13px;padding:12px 14px;font-size:12.5px;
  color:var(--ink-2);line-height:1.55}
.notice-err{background:rgba(224,69,94,.07);border-color:rgba(224,69,94,.22)}

.kv{display:flex;flex-direction:column}
.kv>div{display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}
.kv>div:last-child{border-bottom:none}
.kv span{color:var(--muted)}
.kv strong{font-weight:600;text-align:right}

@media (max-width:1080px){
  .login{grid-template-columns:1fr}.hero{display:none}.pane{padding:34px 20px}
  .dash{grid-template-columns:1fr}
  .dash-side{flex-direction:row;align-items:center;gap:12px;overflow-x:auto;border-right:none;
    border-bottom:1px solid var(--line);padding:12px 16px}
  .dash-side nav{flex-direction:row;flex:1}
  .side-tools{border-top:none;padding-top:0}
  .theme-inline{width:auto;white-space:nowrap}
  .dash-who{padding-top:0;border-top:none;border-left:1px solid var(--line);padding-left:12px}
  .grid-2,.detail-split,.meters-2col{grid-template-columns:1fr}
  .stat-row{grid-template-columns:1fr 1fr}
  .dash-top,.dash-body{padding-left:18px;padding-right:18px}
}
@media (max-width:560px){
  .card{padding:24px 20px 22px;border-radius:20px}
  .stat-row{grid-template-columns:1fr}
  .profile-row{flex-direction:column;text-align:center}
  .person-row{grid-template-columns:1fr auto}
  .person-bar{display:none}
  .boot-bar,.boot-steps{width:min(300px,84vw);min-width:0}
  .table{font-size:12px}.q-text{max-width:170px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;
    transition-duration:.01ms!important}
}


/* ===== sessions & examens ===== */
.pick-block{margin-top:16px}
.pick-label{display:block;font-size:12px;font-weight:500;color:var(--ink-2);margin-bottom:8px}
.pick-label em{font-style:normal;color:var(--muted);font-weight:400}

.sess-list{display:flex;flex-direction:column;gap:10px}
.sess-card{border:1px solid var(--line);border-radius:16px;background:var(--bg);overflow:hidden;
  transition:border-color .2s,box-shadow .2s}
.sess-card.open{border-color:var(--grad-a);box-shadow:0 6px 20px -8px rgba(79,70,229,.28)}
.sess-head{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;
  padding:14px 16px;background:none;border:none;cursor:pointer;text-align:left;color:var(--ink)}
.sess-head:hover{background:var(--line)}
.sess-title strong{display:block;font-size:14px}
.sess-title .dim{font-size:11px;font-family:'JetBrains Mono',monospace}
.sess-meta{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.status-brouillon{background:var(--line);color:var(--ink-2)}
.status-sujet-prêt{background:rgba(79,70,229,.12);color:#4338CA}
.status-ouverte{background:rgba(14,164,124,.13);color:#0B8B69}
.status-évaluation-en-cours{background:rgba(232,147,12,.15);color:#B4700A}
.status-terminée{background:rgba(124,58,237,.13);color:#6D28D9}

.sess-progress{display:flex;align-items:center;gap:12px;padding:0 16px 12px}
.prog-rail{flex:1;height:6px;background:var(--line);border-radius:4px;overflow:hidden}
.prog-fill{height:100%;border-radius:4px;transition:width .5s cubic-bezier(.22,.9,.28,1);
  background:linear-gradient(90deg,var(--grad-a),var(--grad-b))}
.sess-progress .mono{font-size:11px;color:var(--muted);white-space:nowrap}

.sess-body{padding:0 16px 16px;border-top:1px solid var(--line);animation:fadeIn .3s ease both}
.sess-actions{display:flex;flex-wrap:wrap;gap:8px;padding:14px 0}
.btn-act{display:flex;align-items:center;gap:7px;padding:9px 14px;border:1px solid var(--line-2);
  border-radius:11px;background:var(--panel);color:var(--ink-2);font-size:12.5px;font-weight:500;
  cursor:pointer;transition:all .18s}
.btn-act:hover:not(:disabled){border-color:var(--grad-a);color:var(--grad-a);transform:translateY(-1px)}
.btn-act:disabled{opacity:.45;cursor:not-allowed}
.btn-act-primary{background:linear-gradient(120deg,var(--grad-a),var(--grad-b));color:#fff;border-color:transparent}
.btn-act-primary:hover:not(:disabled){color:#fff;box-shadow:0 8px 18px -6px rgba(79,70,229,.5)}
.sess-stats{display:flex;flex-wrap:wrap;gap:20px;font-size:12px;color:var(--muted);
  padding-bottom:14px;border-bottom:1px solid var(--line);margin-bottom:14px}
.sess-stats strong{color:var(--ink);font-weight:600;margin-left:5px}
.sess-table{font-size:12.5px}
.sess-table .q-text{max-width:300px}

.exam-card{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px;
  border:1px solid var(--line);border-radius:16px;background:var(--bg)}
.exam-info{flex:1;min-width:0}
.exam-info strong{display:block;font-size:14px}
.exam-info .dim{font-size:11.5px}
.exam-prog{display:flex;align-items:center;gap:10px;margin-top:9px;max-width:340px}
.exam-prog .mono{font-size:11px;color:var(--muted)}
.exam-side{display:flex;flex-direction:column;align-items:flex-end;gap:9px}

.exam-topbar{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.exam-track{flex:1;display:flex;align-items:center;gap:11px;min-width:180px}
.exam-track .mono{font-size:11.5px;color:var(--muted);white-space:nowrap}
.btn-mini.back{align-self:flex-start}

.q-block{background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:14px}
.q-tags{display:flex;gap:7px;margin-bottom:10px}
.q-statement{font-size:15px;line-height:1.65;color:var(--ink);font-weight:450}
.answer-area{width:100%;min-height:170px;padding:14px 16px;border:1px solid var(--line-2);
  border-radius:14px;font-family:inherit;font-size:14px;line-height:1.65;background:var(--panel);
  color:var(--ink);resize:vertical;transition:border-color .18s,box-shadow .18s}
.answer-area:focus{outline:none;border-color:var(--grad-a);box-shadow:0 0 0 4px rgba(79,70,229,.13)}
.answer-area:disabled{opacity:.7;cursor:not-allowed}
.answer-area::placeholder{color:var(--muted)}
.answer-foot{display:flex;align-items:center;gap:14px;margin-top:9px;font-size:12px;flex-wrap:wrap}
.err-inline{display:flex;align-items:center;gap:6px;color:var(--err)}
.ok-inline{display:flex;align-items:center;gap:6px;color:var(--ok)}
.exam-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;
  padding-top:16px;border-top:1px solid var(--line)}

.all-list{display:flex;flex-direction:column;gap:7px}
.all-item{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--line);
  border-radius:13px;background:var(--bg);cursor:pointer;text-align:left;color:var(--ink);transition:all .18s}
.all-item:hover{border-color:var(--grad-a);transform:translateX(3px)}
.all-item.ok{border-color:rgba(14,164,124,.4)}
.all-item.cur{background:rgba(79,70,229,.06)}
.all-num{width:24px;height:24px;border-radius:8px;display:grid;place-items:center;flex-shrink:0;
  font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;color:#fff;
  background:linear-gradient(135deg,var(--grad-a),var(--grad-b))}
.all-text{flex:1;font-size:12.5px;line-height:1.5}
.all-check{color:var(--ok);flex-shrink:0}

.res-cards{display:flex;flex-direction:column;gap:12px}
.res-card{border:1px solid var(--line);border-radius:16px;padding:16px 18px;background:var(--bg)}
.res-q{display:flex;gap:11px;align-items:flex-start;margin-bottom:11px}
.res-q p{font-size:13.5px;line-height:1.6;flex:1}
.res-answer{font-size:12.5px;line-height:1.65;color:var(--ink-2);background:var(--panel);
  border:1px solid var(--line);border-radius:11px;padding:11px 13px;margin-bottom:12px}
.res-scores{display:flex;flex-wrap:wrap;gap:20px;align-items:center}
.res-scores>div{display:flex;flex-direction:column;gap:2px}
.res-scores span{font-size:10.5px;color:var(--muted)}
.res-scores strong{font-size:15px}
.res-final{margin-left:auto;text-align:right}
.res-final strong{font-size:20px}
.res-feedback{margin-top:12px;padding-top:11px;border-top:1px solid var(--line);
  font-size:12px;line-height:1.6;color:var(--muted)}

@media (max-width:700px){
  .sess-head{flex-direction:column;align-items:flex-start;gap:9px}
  .exam-card{flex-direction:column;align-items:stretch}
  .exam-side{align-items:stretch}
  .exam-nav{flex-wrap:wrap}
  .res-final{margin-left:0;text-align:left}
}


/* ===== circuit de demandes ===== */
.gap-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
.gap-card{display:flex;flex-direction:column;gap:5px;padding:13px 15px;border:1px solid var(--line);
  border-radius:14px;background:var(--bg);cursor:pointer;text-align:left;color:var(--ink);transition:all .18s}
.gap-card:hover{border-color:var(--grad-a);transform:translateY(-2px);box-shadow:var(--shadow)}
.gap-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
.gap-head strong{font-size:13.5px}
.gap-sub{font-size:11.5px;color:var(--muted)}
.gap-cta{display:flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;
  color:var(--grad-a);margin-top:4px}

.req-list{display:flex;flex-direction:column;gap:10px}
.req-card{display:flex;gap:16px;padding:15px 17px;border:1px solid var(--line);border-radius:16px;
  background:var(--bg);align-items:flex-start}
.req-main{flex:1;min-width:0}
.req-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.req-head strong{font-size:14px;line-height:1.4}
.req-tags{display:flex;gap:6px;flex-shrink:0}
.req-just{font-size:12.5px;line-height:1.6;color:var(--ink-2);margin-top:7px}
.req-meta{display:flex;flex-wrap:wrap;gap:16px;margin-top:10px;font-size:11.5px;color:var(--muted)}
.req-meta span{display:flex;align-items:center;gap:6px}
.req-review{display:flex;align-items:flex-start;gap:7px;margin-top:11px;padding:9px 12px;
  background:rgba(79,70,229,.06);border-radius:10px;font-size:12px;color:var(--ink-2);line-height:1.55}
.req-linked{display:flex;align-items:center;gap:7px;margin-top:9px;font-size:11.5px;
  color:var(--ok);font-weight:500}
.req-actions{flex-shrink:0;display:flex;flex-direction:column;gap:8px;min-width:190px}
.req-done{font-size:11px;color:var(--muted);white-space:nowrap}

.prio-haute{background:rgba(224,69,94,.12);color:#C22F45}
.prio-normale{background:var(--line);color:var(--ink-2)}
.prio-basse{background:rgba(136,146,166,.14);color:var(--muted)}
.rstatus-en_attente{background:rgba(232,147,12,.15);color:#B4700A}
.rstatus-validée{background:rgba(14,164,124,.13);color:#0B8B69}
.rstatus-refusée{background:rgba(224,69,94,.12);color:#C22F45}
.rstatus-planifiée{background:rgba(124,58,237,.13);color:#6D28D9}

.review-box{display:flex;flex-direction:column;gap:8px}
.review-comment{width:100%;min-height:62px;padding:9px 11px;border:1px solid var(--line-2);
  border-radius:11px;font-family:inherit;font-size:12px;line-height:1.5;background:var(--panel);
  color:var(--ink);resize:vertical}
.review-comment:focus{outline:none;border-color:var(--grad-a);box-shadow:0 0 0 3px rgba(79,70,229,.12)}
.review-btns{display:flex;gap:7px}
.review-btns .btn-act{flex:1;justify-content:center;padding:8px 10px;font-size:12px}
.btn-act-ok{border-color:rgba(14,164,124,.4);color:var(--ok)}
.btn-act-ok:hover:not(:disabled){background:rgba(14,164,124,.1);border-color:var(--ok);color:var(--ok)}
.btn-act-no{border-color:rgba(224,69,94,.35);color:var(--err)}
.btn-act-no:hover:not(:disabled){background:rgba(224,69,94,.08);border-color:var(--err);color:var(--err)}

@media (max-width:760px){
  .req-card{flex-direction:column}
  .req-actions{min-width:0;width:100%}
}


/* ===== page d'accueil publique ===== */
.landing{min-height:100vh;background:var(--bg);color:var(--ink)}

.nav{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;
  gap:20px;padding:13px 32px;background:var(--glass);backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.nav-brand{display:flex;align-items:center;gap:11px}
.nav-brand strong{display:block;font-family:'Poppins',sans-serif;font-size:17px;
  font-weight:700;letter-spacing:-.5px;line-height:1.15}
.nav-brand span{display:block;font-size:11px;color:var(--muted)}
.nav-links{display:flex;gap:4px}
.nav-link{padding:8px 16px;border:none;background:none;color:var(--ink-2);font-size:13.5px;
  border-radius:10px;cursor:pointer;transition:background .18s,color .18s}
.nav-link:hover{background:var(--line);color:var(--ink)}
.nav-link.on{background:rgba(79,70,229,.1);color:var(--grad-a);font-weight:500}
.nav-actions{display:flex;align-items:center;gap:9px}
.nav-icon{width:34px;height:34px;border:none;background:none;border-radius:10px;color:var(--ink-2);
  display:grid;place-items:center;cursor:pointer;transition:background .18s}
.nav-icon:hover{background:var(--line);color:var(--ink)}
.nav-ghost{padding:8px 15px;border:none;background:none;color:var(--ink);font-size:13.5px;
  font-weight:500;border-radius:10px;cursor:pointer;transition:background .18s}
.nav-ghost:hover{background:var(--line)}
.nav-cta{padding:9px 18px;border:none;border-radius:11px;color:#fff;font-size:13.5px;font-weight:600;
  cursor:pointer;background:linear-gradient(120deg,var(--grad-a),var(--grad-b));
  box-shadow:0 6px 16px -6px rgba(79,70,229,.5);transition:transform .16s,box-shadow .2s}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 10px 22px -8px rgba(79,70,229,.6)}

.lp-hero{position:relative;overflow:hidden;padding:82px 32px 70px;text-align:center}
.lp-orb{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;
  animation:drift 24s ease-in-out infinite}
.lp-orb-1{width:420px;height:420px;background:rgba(79,70,229,.16);top:-140px;left:8%}
.lp-orb-2{width:360px;height:360px;background:rgba(124,58,237,.14);top:40px;right:6%;animation-delay:-9s}
.lp-hero-inner{position:relative;z-index:2;max-width:820px;margin:0 auto}
.lp-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 15px;border-radius:22px;
  background:var(--panel);border:1px solid var(--line);font-size:11.5px;color:var(--ink-2);
  box-shadow:var(--shadow-sm)}
.lp-badge svg{color:var(--grad-a)}
.lp-title{font-family:'Poppins',sans-serif;font-size:46px;line-height:1.1;font-weight:700;
  letter-spacing:-1.6px;margin-top:22px;min-height:56px}
.lp-sub{font-size:16px;line-height:1.7;color:var(--ink-2);max-width:610px;margin:18px auto 0}
.lp-cta-row{display:flex;flex-wrap:wrap;gap:11px;justify-content:center;margin-top:28px}
.lp-btn2{width:auto;padding:12px 22px}
.lp-figures{display:flex;flex-wrap:wrap;justify-content:center;gap:44px;margin-top:46px;
  padding-top:30px;border-top:1px solid var(--line)}
.lp-figures>div{display:flex;flex-direction:column;gap:3px}
.lp-figures strong{font-family:'Poppins',sans-serif;font-size:25px;font-weight:700;letter-spacing:-.8px}
.lp-figures span{font-size:11.5px;color:var(--muted)}

.lp-section{padding:64px 32px}
.lp-alt{background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.lp-narrow{max-width:680px;margin:0 auto;text-align:center}
.lp-eyebrow{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.4px;color:var(--grad-a)}
.lp-h2{font-family:'Poppins',sans-serif;font-size:29px;line-height:1.25;font-weight:600;
  letter-spacing:-.9px;margin-top:10px}
.lp-text{font-size:14.5px;line-height:1.75;color:var(--ink-2);margin-top:14px}

.lp-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(226px,1fr));gap:14px;
  max-width:1080px;margin:38px auto 0}
.lp-step{position:relative;padding:22px;border:1px solid var(--line);border-radius:18px;
  background:var(--bg);transition:transform .2s,box-shadow .2s}
.lp-step:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.lp-step-n{position:absolute;top:16px;right:18px;font-family:'JetBrains Mono',monospace;
  font-size:12px;font-weight:600;color:var(--line-2)}
.lp-step-ico{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff;
  background:linear-gradient(135deg,var(--grad-a),var(--grad-b));margin-bottom:14px;
  box-shadow:0 6px 14px -5px rgba(79,70,229,.5)}
.lp-step strong{display:block;font-size:14.5px;font-weight:600}
.lp-step p{font-size:12.5px;line-height:1.65;color:var(--muted);margin-top:7px}

.lp-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;
  max-width:1080px;margin:34px auto 0}
.lp-role{position:relative;display:flex;gap:13px;padding:18px;border:1px solid var(--line);
  border-radius:16px;background:var(--panel)}
.lp-role-ico{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;flex-shrink:0;
  background:rgba(79,70,229,.1);color:var(--grad-a)}
.lp-role strong{display:block;font-size:13.5px;font-weight:600}
.lp-role p{font-size:12px;line-height:1.6;color:var(--muted);margin-top:5px}
.lp-role-arrow{position:absolute;right:-16px;top:50%;transform:translateY(-50%);
  color:var(--line-2);z-index:2}

.lp-contact{padding:8px 0}
.lp-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;
  padding:26px 32px;border-top:1px solid var(--line)}
.lp-foot-note{font-size:11.5px;color:var(--muted)}

.pane-full{min-height:100vh;position:relative}
.back-abs{position:absolute;top:24px;left:26px}
.ok-badge{display:inline-grid;place-items:center;width:60px;height:60px;border-radius:50%;
  background:rgba(14,164,124,.12);color:var(--ok)}

@media (max-width:900px){
  .nav{padding:12px 18px;flex-wrap:wrap}
  .nav-links{order:3;width:100%;justify-content:center}
  .lp-title{font-size:33px;letter-spacing:-1px}
  .lp-hero{padding:56px 18px 48px}
  .lp-section{padding:48px 18px}
  .lp-figures{gap:28px}
  .lp-role-arrow{display:none}
}
@media (max-width:560px){
  .nav-brand span{display:none}
  .nav-ghost{display:none}
  .lp-title{font-size:27px}
  .lp-h2{font-size:23px}
}
