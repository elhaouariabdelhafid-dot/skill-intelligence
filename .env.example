# ===== LLM =====
# Provider : "ollama" (local, gratuit, défaut dev) ou "anthropic" / "openai"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===== Infrastructure =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aws_docs

POSTGRES_USER=skill
POSTGRES_PASSWORD=skill
POSTGRES_DB=skilldb
DATABASE_URL=postgresql://skill:skill@localhost:5432/skilldb

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ===== Observabilité (créer les clés dans http://localhost:3000) =====
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SECRET=changeme-secret
LANGFUSE_SALT=changeme-salt

# ===== Embeddings / Reranker =====
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
